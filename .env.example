# ==============================================================================
# F.R.I.D.A.Y. 2.0 // AI Stock Analyst with n8n & Human-Like Voice Calls
# Environment Configuration Template
# NOTE: Do NOT commit your actual secrets (.env) to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telephony Safety Switch (CRITICAL)
# ------------------------------------------------------------------------------
# Must remain "false" by default to prevent accidental cellular charges or spam.
# Set to "true" ONLY after testing credentials and setting phone number.
CALLS_ENABLED=false

# Target verified recipient phone number (E.164 international format)
NOTIFICATION_PHONE=+916382480091

# Active Telephony Provider: "exotel" (recommended for India) or "twilio"
TELEPHONY_PROVIDER=exotel

# ------------------------------------------------------------------------------
# 2. Exotel Indian Telephony Configuration (Recommended for TRAI/DLT Compliance)
# ------------------------------------------------------------------------------
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_CALLER_ID=080XXXXXXXX      # Your virtual Exophone number
EXOTEL_APP_ID=your_flow_app_id    # Optional: IVR flow app ID for 2-way call
EXOTEL_SUBDOMAIN=api.exotel.com

# ------------------------------------------------------------------------------
# 3. Twilio Telephony Configuration (International Outbound & WebRTC Voice)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ------------------------------------------------------------------------------
# 4. ElevenLabs Conversational Voice AI (Ultra-Realistic Teenage Indian Voice)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel / Teenage conversational voice
ELEVENLABS_AGENT_ID=your_conversational_agent_id_here

# ------------------------------------------------------------------------------
# 5. Financial Data & LLM Reasoning APIs
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
ALPHA_VANTAGE_API_KEY=demo
FINNHUB_API_KEY=demo

# ------------------------------------------------------------------------------
# 6. n8n Automation Orchestration Webhooks
# ------------------------------------------------------------------------------
# Publicly accessible webhook base URL (e.g. your ngrok or deployed n8n instance)
N8N_BASE_URL=https://your-n8n-instance.app.n8n.cloud
N8N_RESEARCH_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/stock-research
N8N_VOICE_CALLBACK_URL=https://indian-equity-research.onrender.com/webhook/voice-milestone-call

# ------------------------------------------------------------------------------
# 7. Application Server Settings
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
DEBUG=false
